<Window x:Class="WebMacros.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebMacros" Height="900" Width="1450" MinWidth="900" MinHeight="600"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="F5" Command="ApplicationCommands.Open" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveCommand" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnPlayCommand" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation bar -->
        <Grid Grid.Row="0" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Content="◀" ToolTip="Back" Click="OnBack" />
            <Button Grid.Column="1" x:Name="ForwardButton" Content="▶" ToolTip="Forward" Click="OnForward" />
            <Button Grid.Column="2" x:Name="ReloadButton" Content="⟳" ToolTip="Reload" Click="OnReload" />
            <TextBox Grid.Column="3" x:Name="AddressBox" Margin="4,2" VerticalContentAlignment="Center" FontSize="13" KeyDown="OnAddressKeyDown" />
            <Button Grid.Column="4" Content="Go" Click="OnGo" />
        </Grid>

        <!-- Tab strip -->
        <DockPanel Grid.Row="1" Margin="4,0">
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close tab" Click="OnCloseTab" />
            <Button DockPanel.Dock="Right" Content="+" ToolTip="New tab" Click="OnNewTab" />
            <ListBox x:Name="TabStrip" DisplayMemberPath="Header" SelectionChanged="OnTabSelectionChanged" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="BorderBrush" Value="#CCC" />
                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side panel: macros and controls -->
            <DockPanel Grid.Column="0" Margin="4">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Macros" FontWeight="Bold" Margin="2,0,0,4" />
                    <WrapPanel>
                        <Button x:Name="PlayButton" Content="▶ Play" Click="OnPlay" ToolTip="Play the macro in the editor (F5)" />
                        <Button x:Name="PlayLoopButton" Content="⟲ Play Loop" Click="OnPlayLoop" />
                        <TextBlock Text="Max:" VerticalAlignment="Center" Margin="4,0,2,0" />
                        <TextBox x:Name="LoopCountBox" Width="42" Text="3" VerticalContentAlignment="Center" Margin="2" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="RecordButton" Content="● Record" Click="OnRecord" Foreground="DarkRed" />
                        <Button x:Name="StopButton" Content="■ Stop" Click="OnStop" IsEnabled="False" />
                        <Button x:Name="ResumeButton" Content="Resume" Click="OnResume" IsEnabled="False" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="NewButton" Content="New" Click="OnNew" />
                        <Button x:Name="SaveButton" Content="Save" Click="OnSave" ToolTip="Save (Ctrl+S)" />
                        <Button Content="Save as…" Click="OnSaveAs" />
                        <Button Content="↻" ToolTip="Refresh list" Click="OnRefreshList" />
                        <Button Content="Folder" ToolTip="Open the macros folder in Explorer" Click="OnOpenFolder" />
                    </WrapPanel>
                </StackPanel>
                <ListBox x:Name="MacroList" Margin="0,6,0,0" MouseDoubleClick="OnMacroDoubleClick" SelectionChanged="OnMacroSelected" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="300" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- WebView2 instances (one per tab) are added here by the driver -->
                <Grid x:Name="BrowserHost" Grid.Row="0" Background="White" />

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#EEE" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="2">
                            <TextBlock x:Name="EditorTitle" Text="Untitled.iim" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="CaretInfo" Text="" Margin="10,0,0,0" Foreground="Gray" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="Editor" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#FFD54F" SelectionOpacity="0.6"
                                 TextChanged="OnEditorTextChanged" SelectionChanged="OnEditorSelectionChanged" />
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="2">
                            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearLog" Padding="6,0" />
                            <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopyLog" Padding="6,0" />
                            <TextBlock Text="Log" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" VirtualizingPanel.IsVirtualizing="True" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CurrentLineText" Text="" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
